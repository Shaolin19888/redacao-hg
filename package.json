{
  "name": "redacao-hg",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "worker": "npm run worker --workspace=apps/web",
    "start": "./scripts/start-dev.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=apps/web",
    "db:seed": "npm run db:seed --workspace=apps/web",
    "db:studio": "npm run db:studio --workspace=apps/web",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "autoprefixer": "^10.5.2",
    "prisma": "^7.8.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "prisma@7.8.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/client@7.8.0": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/engines@7.8.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
