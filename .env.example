# Base de dados
DATABASE_URL=postgresql://redacao:password@localhost:5432/redacao_hg
POSTGRES_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Utilizador inicial do painel
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# OpenAI (Fase 5)
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Anthropic (Fase 5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TEXT=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# WordPress (Fase 6)
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_DEFAULT_STATUS=draft

# Push
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
PUSHALERT_API_KEY=

# Social Hub — Meta (Facebook + Instagram)
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://o-teu-dominio/api/social/oauth/facebook/callback
INSTAGRAM_REDIRECT_URI=https://o-teu-dominio/api/social/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Social Hub — encriptação de tokens (32 bytes hex)
SOCIAL_ENCRYPTION_KEY=

# Pipeline — aprovação por Telegram (Fase 5)
# Criar bot com @BotFather; chat id do canal/grupo onde recebes os pedidos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Segredo do webhook (qualquer string aleatória; validado em cada callback).
TELEGRAM_WEBHOOK_SECRET=
# Opcional: ids de utilizadores Telegram autorizados a decidir, separados por vírgula.
TELEGRAM_ALLOWED_USER_IDS=
# Opcional: chat dedicado ao relatório semanal. Se vazio, usa o TELEGRAM_CHAT_ID acima.
TELEGRAM_REPORT_CHAT_ID=
# URL público HTTPS deste servidor (ngrok/VPS) para registar o webhook.
APP_PUBLIC_URL=

# Site Health — Google Search Console (Fase 8, opcional: indexação real)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# WordPress público (exposto ao browser)
NEXT_PUBLIC_WORDPRESS_URL=

